# Telegram
TELEGRAM_BOT_TOKEN=123456789:your_bot_token
TELEGRAM_CHAT_ID=123456789

# 감시 대상
CGV_MOVIE_NAME=프로젝트 헤일메리
CGV_THEATER_NAME=용산아이파크몰
CGV_PLAY_DATE=2026-03-29
CGV_SCREEN_FORMAT=IMAX

# 주기/타임아웃
POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=15
STATE_FILE=state/last_status.json

# 조회 방법 1) 저장소 v1에서 사용하던 RIA API (권장)
# 아래 3개는 JSON 문자열이어야 하며, 값이 없으면 폴백(BOOKING_PAGE_URL)만 사용합니다.
CGV_API_URL=http://ticket.cgv.co.kr/CGV2011/RIA/CJ000.aspx/CJ_TICKET_SCHEDULE_TOTAL_PLAY_YMD
CGV_PAYLOAD_JSON={}
CGV_HEADERS_JSON={}
CGV_COOKIES_JSON={}

# 조회 방법 2) HTML 페이지 폴백 URL
BOOKING_PAGE_URL=
